-- 开关逻辑
local function toggleAutoInteract()
    _G.AutoInteractEnabled = not _G.AutoInteractEnabled
    toggleButton.Text = "Auto Interact: " .. (_G.AutoInteractEnabled and "ON" or "OFF")
    toggleButton.BackgroundColor3 = _G.AutoInteractEnabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(70, 70, 70)

    if _G.AutoInteractEnabled then
        -- 启用即时交互
        for _, descendant in pairs(game:GetDescendants()) do
            makeInstant(descendant)
        end
        local connection = game.DescendantAdded:Connect(makeInstant)

        -- 无条件自动模拟“E”键
        task.spawn(function()
            while _G.AutoInteractEnabled do
                task.wait(0.1) -- 按键频率
                VirtualInputManager:SendKeyEvent(true, "E", false, game)
                task.wait(0.01) -- 模拟按键持续时间
                VirtualInputManager:SendKeyEvent(false, "E", false, game)
            end
            -- 清理连接
            connection:Disconnect()
        end)
    else
        -- 关闭时恢复原始HoldDuration
        for _, descendant in pairs(game:GetDescendants()) do
            restoreDuration(descendant)
        end
    end
end

-- 绑定按钮点击
toggleButton.MouseButton1Click:Connect(toggleAutoInteract)

-- 支持拖动GUI
local dragging, dragInput, dragStart, startPos

local function updateInput(input)
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

frame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        updateInput(input)
    end
end)