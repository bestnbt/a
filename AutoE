-- 获取服务
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local StarterGui = game:GetService("StarterGui")

-- 全局变量
_G.AutoInteractEnabled = false
local originalDurations = {} -- 存储原始HoldDuration

-- 即时交互函数
local function makeInstant(prompt)
    if prompt:IsA("ProximityPrompt") then
        originalDurations[prompt] = prompt.HoldDuration -- 保存原始值
        prompt.HoldDuration = 0
    end
end

local function restoreDuration(prompt)
    if prompt:IsA("ProximityPrompt") and originalDurations[prompt] then
        prompt.HoldDuration = originalDurations[prompt]
    end
end

