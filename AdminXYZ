-- End and copy button
local endButton = Instance.new("TextButton")
endButton.Size = UDim2.new(0.45, -5, 0, 30)
endButton.Position = UDim2.new(0.55, 0, 1, -60)
endButton.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
endButton.TextColor3 = Color3.new(1, 1, 1)
endButton.Text = "End and Copy"
endButton.TextSize = 14
endButton.Parent = frame

-- Coordinate and note list
local coordinates = {}

-- Copy to clipboard
local function copyToClipboard(text)
    if setclipboard then
        setclipboard(text)
        StarterGui:SetCore("SendNotification", {
            Title = "Copied",
            Text = "All coordinates and notes copied to clipboard",
            Duration = 3
        })
    else
        warn("Clipboard function not supported on this device")
    end
end

-- Get player position
local function getPlayerPosition()
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local position = character.HumanoidRootPart.Position
        return string.format("%.2f, %.2f, %.2f", position.X, position.Y, position.Z)
    end
    return nil
end

-- Update scrolling frame canvas size
local function updateCanvasSize()
    local totalHeight = uiListLayout.AbsoluteContentSize.Y
    recordContainer.Size = UDim2.new(1, 0, 0, totalHeight)
    scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 10)
end

-- Create UI for a single record
local function createRecordUI(index, position, note)
    local recordFrame = Instance.new("Frame")
    recordFrame.Size = UDim2.new(1, 0, 0, 30)
    recordFrame.BackgroundTransparency = 1
    recordFrame.LayoutOrder = index
    recordFrame.Parent = recordContainer

    local recordText = Instance.new("TextBox")
    recordText.Size = UDim2.new(0.7, -5, 1, 0)
    recordText.Position = UDim2.new(0, 0, 0, 0)
    recordText.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
    recordText.TextColor3 = Color3.new(1, 1, 1)
    recordText.TextSize = 14
    recordText.Font = Enum.Font.SourceSans
    recordText.Text = position .. " - " .. note
    recordText.TextXAlignment = Enum.TextXAlignment.Left
    recordText.ClearTextOnFocus = false
    recordText.Parent = recordFrame

    local deleteButton = Instance.new("TextButton")
    deleteButton.Size = UDim2.new(0.15, 0, 1, 0)
    deleteButton.Position = UDim2.new(0.75, 0, 0, 0)
    deleteButton.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    deleteButton.TextColor3 = Color3.new(1, 1, 1)
    deleteButton.Text = "X"
    deleteButton.TextSize = 14
    deleteButton.Parent = recordFrame

    local editButton = Instance.new("TextButton")
    editButton.Size = UDim2.new(0.15, 0, 1, 0)
    editButton.Position = UDim2.new(0.9, 0, 0, 0)
    editButton.BackgroundColor3 = Color3.fromRGB(0, 0, 150)
    editButton.TextColor3 = Color3.new(1, 1, 1)
    editButton.Text = "E"
    editButton.TextSize = 14
    editButton.Parent = recordFrame

    -- Delete record
    deleteButton.MouseButton1Click:Connect(function()
        table.remove(coordinates, index)
        recordFrame:Destroy()
        for i, otherFrame in ipairs(recordContainer:GetChildren()) do
            if otherFrame:IsA("Frame") then
                otherFrame.LayoutOrder = i
                local otherDeleteButton = otherFrame:FindFirstChildWhichIsA("TextButton", true)
                local otherEditButton = otherFrame:FindFirstChildWhichIsA("TextButton", true, otherDeleteButton)
                otherDeleteButton.MouseButton1Click:Connect(function()
                    table.remove(coordinates, i)
                    otherFrame:Destroy()
                    updateCanvasSize()
                end)
                otherEditButton.MouseButton1Click:Connect(function()
                    noteInput.Text = coordinates[i]:match(".- %- (.+)") or "No note"
                    table.remove(coordinates, i)
                    otherFrame:Destroy()
                    updateCanvasSize()
                end)
            end
        end
        updateCanvasSize()
    end)

    -- Edit record
    editButton.MouseButton1Click:Connect(function()
        noteInput.Text = note ~= "No note" and note or ""
        table.remove(coordinates, index)
        recordFrame:Destroy()
        updateCanvasSize()
    end)
end

-- Record coordinate and note
recordButton.MouseButton1Click:Connect(function()
    local position = getPlayerPosition()
    if position then
        local note = noteInput.Text ~= "" and noteInput.Text or "No note"
        local entry = position .. " - " .. note
        table.insert(coordinates, entry)
        createRecordUI(#coordinates, position, note)
        updateCanvasSize()
        noteInput.Text = ""
        StarterGui:SetCore("SendNotification", {
            Title = "Coordinate Recorded",
            Text = "Recorded: " .. entry,
            Duration = 2
        })
    else
        warn("Unable to retrieve player coordinates")
    end
end)

-- End and copy
endButton.MouseButton1Click:Connect(function()
    if #coordinates > 0 then
        local allCoords = table.concat(coordinates, "\n")
        copyToClipboard(allCoords)
        coordinates = {}
        recordContainer:ClearAllChildren()
        local newUIListLayout = Instance.new("UIListLayout")
        newUIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
        newUIListLayout.Padding = UDim.new(0, 5)
        newUIListLayout.Parent = recordContainer
        noteInput.Text = ""
        updateCanvasSize()
    else
        StarterGui:SetCore("SendNotification", {
            Title = "No Coordinates",
            Text = "Please record coordinates first",
            Duration = 3
        })
    end
end)

-- Minimize/Restore functionality
local isMinimized = false
minimizeButton.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        frame.Size = UDim2.new(0, 250, 0, 30)
        noteInput.Visible = false
        scrollingFrame.Visible = false
        recordButton.Visible = false
        endButton.Visible = false
        minimizeButton.Text = "+"
    else
        frame.Size = UDim2.new(0, 250, 0, 300)
        noteInput.Visible = true
        scrollingFrame.Visible = true
        recordButton.Visible = true
        endButton.Visible = true
        minimizeButton.Text = "-"
    end
end)

-- Wait for character to load
local function init()
    if not player.Character then
        player.CharacterAdded:Wait()
    end
    wait(0.5)
end

init()