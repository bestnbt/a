-- SETTINGS
_G.BoxSize = 30
_G.Enabled = true

-- UTIL: Reset Hitbox
local function resetHitbox(player)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		pcall(function()
			hrp.Size = Vector3.new(2, 2, 1) -- default size
			hrp.Transparency = 1
			hrp.BrickColor = BrickColor.new("Medium stone grey")
			hrp.Material = Enum.Material.Plastic
			hrp.CanCollide = true
		end)
	end
end

-- Highlighting Logic
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

RunService.RenderStepped:Connect(function()
	for _, v in pairs(Players:GetPlayers()) do
		if v ~= Players.LocalPlayer and v.Character and v.Character:FindFirstChild("Humanoid") then
			local hrp = v.Character:FindFirstChild("HumanoidRootPart")
			local humanoid = v.Character:FindFirstChild("Humanoid")

			if _G.Enabled and hrp and humanoid.Health > 0 then
				pcall(function()
					hrp.Size = Vector3.new(_G.BoxSize, _G.BoxSize, _G.BoxSize)
					hrp.Transparency = 0.4
					hrp.BrickColor = BrickColor.new("Pastel light blue")
					hrp.Material = Enum.Material.SmoothPlastic
					hrp.CanCollide = false
				end)
			elseif hrp then
				resetHitbox(v)
			end
		end
	end
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		wait(1)
		if not _G.Enabled then
			resetHitbox(player)
		end
	end)
end)

-- GUI START
local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.Name = "HighlightGui"
gui.ResetOnSpawn = false

-- Corner Style Function
local function roundify(obj, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = obj
end

