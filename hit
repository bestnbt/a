-- Function: Reset Hitboxes on Toggle Off
local function resetAll()
	for _, v in pairs(Players:GetPlayers()) do
		if v ~= Players.LocalPlayer then
			resetHitbox(v)
		end
	end
end

-- Toggle Button Logic
toggle.MouseButton1Click:Connect(function()
	_G.Enabled = not _G.Enabled
	toggle.Text = _G.Enabled and "Turn Off" or "Turn On"
	if not _G.Enabled then resetAll() end
end)

-- Size Box Logic
sizeInput.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		local size = tonumber(sizeInput.Text)
		if size and size > 0 and size <= 200 then
			_G.BoxSize = size
		else
			sizeInput.Text = tostring(_G.BoxSize)
		end
	end
end)

-- Minimize Logic
local minimized = false
minimize.MouseButton1Click:Connect(function()
	minimized = not minimized
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("TextButton") or child:IsA("TextBox") then
			if child ~= minimize then
				child.Visible = not minimized
			end
		end
	end
	title.Visible = not minimized
	minimize.Text = minimized and "Restore" or "Minimize"
end)

-- DK Button Toggle Main GUI
dkButton.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
	if frame.Visible then
		frame.Position = UDim2.new(0.5, -120, 0.5, -90) -- Centered
	end
end)